<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= page.title ? page.title + ' · ' + config.title : config.title + ' · ' + config.subtitle %></title>
  <meta name="description" content="<%= config.description %>">
  <meta name="author" content="<%= config.author %>">
  <link rel="icon" type="image/jpeg" href="<%- url_for('images/avatar.jpg') %>">
  <link rel="stylesheet" href="<%- url_for('css/style.css') %>?v=<%= Date.now() %>">
</head>
<body>
  <header class="site-header">
    <div class="wrap header-inner">
      <a class="brand" href="<%- url_for('/') %>">
        <img class="brand-avatar" src="<%- url_for('images/avatar.jpg') %>" alt="<%= config.author %>">
        <span class="brand-name"><%= config.title %></span>
      </a>
      <nav class="site-nav">
        <a href="<%- url_for('/') %>">首页</a>
        <a href="<%- url_for('archives/') %>">归档</a>
        <a href="<%- url_for('categories/') %>">分类</a>
        <a href="<%- url_for('about/') %>">关于</a>
      </nav>
    </div>
  </header>

  <main class="wrap site-main">
    <%- body %>
  </main>

  <footer class="site-footer">
    <div class="wrap">
      <p><%= config.author %> · <%= config.subtitle %></p>
      <p class="foot-note">用 Hexo 搭建 · 内容持续更新中</p>
    </div>
  </footer>
</body>
</html>
