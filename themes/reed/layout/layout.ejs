<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= page.title ? page.title + ' · ' + config.title : config.title + ' · ' + config.subtitle %></title>
  <meta name="description" content="<%= config.description %>">
  <meta name="author" content="<%= config.author %>">
  <!-- 隐私：跳转到任何外部站点时不发送来源页（Referer） -->
  <meta name="referrer" content="no-referrer">
  <!-- 隐私：禁止任何搜索引擎收录本站 -->
  <meta name="robots" content="noindex, nofollow, noarchive, nosnippet">
  <!-- 安全：禁止被嵌入 iframe、禁止 base 标签劫持、禁止外发表单 -->
  <meta http-equiv="Content-Security-Policy" content="frame-ancestors 'none'; base-uri 'self'; form-action 'self'">
  <link rel="icon" type="image/jpeg" href="<%- url_for('images/avatar.jpg') %>">
  <link rel="stylesheet" href="<%- url_for('css/style.css') %>?v=<%= Date.now() %>">
</head>
<body>
  <header class="site-header">
    <div class="wrap header-inner">
      <a class="brand" href="<%- url_for('/') %>">
        <img class="brand-avatar" src="<%- url_for('images/avatar.jpg') %>" alt="<%= config.author %>">
        <span class="brand-name"><%= config.title %></span>
      </a>
      <nav class="site-nav">
        <a href="<%- url_for('/') %>">首页</a>
        <a href="<%- url_for('archives/') %>">归档</a>
        <a href="<%- url_for('categories/') %>">分类</a>
        <a href="<%- url_for('about/') %>">关于</a>
      </nav>
    </div>
  </header>

  <main class="wrap site-main">
    <%- body %>
  </main>

  <footer class="site-footer">
    <div class="wrap">
      <p><%= config.author %> · <%= config.subtitle %></p>
      <p class="foot-note">
        本站内容采用
        <a href="https://creativecommons.org/licenses/by-nc-sa/4.0/deed.zh-hans" target="_blank" rel="noopener noreferrer nofollow">CC BY-NC-SA 4.0</a>
        许可协议 · 用 Hexo 搭建
      </p>
      <p class="foot-stat">
        <span id="busuanzi_container_site_pv">总访问 <span id="busuanzi_value_site_pv">–</span> 次</span>
        <span class="sep">/</span>
        <span id="busuanzi_container_site_uv">访客 <span id="busuanzi_value_site_uv">–</span> 人</span>
      </p>
    </div>
    <script async src="//busuanzi.ibruce.info/busuanzi/2.3/busuanzi.pure.mini.js"></script>
  </footer>
</body>
</html>
